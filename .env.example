# Template for the root .env used by the local demos and skill upload.
# Generate the real file from azd with `make env`, or copy this file to .env
# and fill in your values. Never commit .env.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
